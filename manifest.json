{
  "manifest_version": 3,
  "name": "Spadinh",
  "description": "ch00nz",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "version": "1.0",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.discogs.com/*", "http://*.discogs.com/*"],
      "js": [
        "scripts/_shared.js",
        "scripts/_global.js",
        "scripts/ratio-filter.js",
        "scripts/dinhscogvery-keys.js",
        "scripts/dinhscogvery-marks.js",
        "scripts/discogs-video-keys.js"
      ]
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["scripts/_shared.js", "scripts/youtube-keys.js"]
    },
    {
      "matches": ["https://www.youtube.com/embed/*", "https://www.youtube-nocookie.com/embed/*"],
      "all_frames": true,
      "js": ["scripts/_shared.js", "scripts/youtube-embed-keys.js"]
    }
  ]
}
